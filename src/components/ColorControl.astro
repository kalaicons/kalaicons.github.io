---
// Picker square + hex field + 6 presets (DESIGN §3.5). Behavior: scripts/controls.ts
import { ui } from '../lib/site';
interface Props { id: string; label?: boolean }
const { id, label = true } = Astro.props;
const presets = [
  { value: '', name: 'Theme text color', cls: 'theme' },
  { value: '#1463FD', name: 'Blue' },
  { value: '#FFB347', name: 'Yellow', cls: 'yellow' },
  { value: '#E03131', name: 'Red' },
  { value: '#2F9E44', name: 'Green' },
  { value: '#7048E8', name: 'Purple' },
];
---
<div class="color-ctl" data-color-ctl={id}>
  {label && <span class="mono-label ctl-label" id={`${id}-label`}>Color</span>}
  <div class="hex-row">
    <label class="picker-sq" title="Pick any color">
      <span class="picker-fill"></span>
      <input type="color" aria-label="Pick any color" />
    </label>
    <div class="hex-field">
      <span aria-hidden="true">#</span>
      <input class="hex" type="text" inputmode="text" maxlength="7" spellcheck="false" autocomplete="off"
        aria-label="Hex color code" aria-describedby={`${id}-err`} placeholder="Theme" />
    </div>
  </div>
  <p class="hex-err" id={`${id}-err`} hidden>Use 3 or 6 hex digits (0–9, A–F)</p>
  <div class="swatches" role="radiogroup" aria-label="Preset colors">
    {presets.map((p) => (
      <button type="button" role="radio" class={`swatch ${p.cls ?? ''}`} data-value={p.value} aria-label={p.name}
        aria-checked="false" tabindex="-1" style={p.value ? `background:${p.value}` : undefined}>
        <span class="ck"><Fragment set:html={ui('check', 16)} /></span>
      </button>
    ))}
  </div>
</div>
